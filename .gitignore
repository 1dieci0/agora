```gitignore
# =========================
# Go
# =========================

# Binaries
backend/bin/
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib

# Go test binaries
backend/*.test

# Coverage
backend/coverage.out
backend/coverage.html

# Environment files
backend/.env
backend/.env.*

# SQLite / local database files
backend/*.db
backend/*.sqlite
backend/*.sqlite3

backend/uploads


# =========================
# React / Node
# =========================

frontend/node_modules/
frontend/dist/
frontend/.vite/

# Environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/*.log


# =========================
# Editors / OS
# =========================

.vscode/
.idea/

.DS_Store
Thumbs.db
*.swp
*.swo
*~
```
